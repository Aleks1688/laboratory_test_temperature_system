  ;; ================================================================
  ;; TEXT NOTES ON SCHEMATIC
  ;; ================================================================
  (text (at 10 280 0)
    (text "=== SAFETY WARNING ===\nThis circuit operates with HIGH VOLTAGE (400-500V AC/DC)\non thermocouple inputs. Full galvanic isolation is required\nbetween HV zone (relays/TC connectors) and LV zone (ESP32/MCU).\n\nCreepage/clearance requirements per IEC 60664-1:\n- Between TC channels: >= 5.0 mm\n- Between HV and LV zones: >= 6.0 mm + slotting\n- Conformal coating MANDATORY on HV section\n\nIsolation chain:\nTC connectors -> IM03GR DPDT (1800Vrms) -> 100ohm protection\n-> MAX31856 (on isolated GND_A) -> ISO7741 (5kVrms digital iso)\n-> ESP32-J2 (on controller GND)"
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid note-safety)
  )

  (text (at 10 20 0)
    (text "Thermocouple Test Controller v2.0\n10-channel K-type thermocouple tester\nDPDT relay multiplexing (both TC wires switched)\nHV isolation: ISO7741 + TMA-0505\nMCU: ESP32-J2 + WiFi MQTT\nLED indication: pilot TH 2x3x4.7mm (soldered bottom, light top)"
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid note-title)
  )
)
